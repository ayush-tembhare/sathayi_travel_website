<% layout('layouts/boilerplate') %>
<!-- <h1>All listings</h1> -->
<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
     
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
     flex: 0 0 auto;
  transition: 0.2s;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
    transform: scale(1.05);
  }
  .filter p{
    font-size: 0.8rem;
     margin-top: 0.4rem;
  }

  /* Hide scrollbar on webkit browsers */
#filters::-webkit-scrollbar {
  display: none;
}

  .tax-info{
    display: none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin-left: 3rem;
    display: flex;
    align-items: center;
  }

  /* ✅ Make it scrollable on mobile */
@media (max-width: 768px) {
  #filters {
    overflow-x: auto;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .filter {
    margin-right: 0.8rem;
    flex: 0 0 auto;
  }

}
</style>

<div id="filters" class="mb-3">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic City</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></i></div>
    <p>Castles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tent"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tractor"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-snowman"></i></div>
    <p>Arctic</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-sailboat"></i></div>
    <p>Boats</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beach</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </div>
  
  <div class="tax-toggle mt-3">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display Taxes</label>
</div>
  </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-3 home-page">
<% for (let listing of allListings) { %>
    <a href="/listings/<%=listing.id%>" class="listing-link">
<div class="card col listing-card">
  <img src="<%=listing.image.url%>"
   class="card-img-top"
    alt="listing_image"
     style="height:20rem;"
     />
  
    <div class="card-img-overlay"></div>

  <div class="card-body">
   <p class="card-text">
  <b><%= listing.title %></b><br>

  <% if (listing.price) { 
       let basePrice = listing.price;
       let gstPrice = basePrice + (basePrice * 0.18);
  %>
    &#8377;<%= basePrice.toLocaleString("en-IN") %> /night
    <i class="tax-info">
      &nbsp;(Incl. GST: &#8377;<%= gstPrice.toLocaleString("en-IN") %>)
    </i>
  <% } else { %>
    N/A
  <% } %>
</p>

  </div>
</div>
</a>
    <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxinfo = document.getElementsByClassName("tax-info");
    for (info of taxinfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });

 const filters = document.querySelectorAll(".filter");
  const selectedCategory = "<%= selectedCategory %>";

  filters.forEach(filter => {
    const category = filter.querySelector("p").textContent.trim();

    // Highlight active filter
    if(category === selectedCategory){
      filter.style.opacity = "1";
      filter.style.fontWeight = "bold";
    }

    filter.addEventListener("click", () => {
      window.location.href = `/listings?category=${encodeURIComponent(category)}`;
    });
  });
</script>