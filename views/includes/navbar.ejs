<style>
  .btn-search {
    background-color: crimson;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
  }

  .btn-search:hover {
    background-color: darkred;
    color: #fff;
  }

  .btn-search i {
    margin-right: 0.5rem;
  }

  .search-input {
    border-radius: 25px;
    padding: 0.5rem 1rem;
  }

  /* Center desktop search */
  .navbar-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Mobile search alignment */
  @media (max-width: 991px) {
    .navbar-mobile-search {
      position: absolute;
      left: 48%;
      transform: translateX(-50%);
      width: 60%;
      max-width: 400px;
    }

    .navbar-mobile-search .input-group {
      width: 100%;
    }
  }
</style>

<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top">
  <div class="container-fluid">
    <!-- Brand -->
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-spa fa-xl" style="color: #d33d22;"></i></a>

    <!-- Hamburger -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup" aria-expanded="false">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Desktop Search (unchanged) -->
      <% if (!(req.originalUrl === "/login" || req.originalUrl === "/signup")) { %>
    <form class="navbar-center d-none d-lg-block" action="/listings/search" method="get">
      <div class="input-group">
        <input class="form-control search-input" type="search" placeholder="Search Destinations" name="q">
        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>

    <!-- Mobile Search -->
    <div class="d-lg-none navbar-mobile-search sticky-top mt-2">
      <form class="w-100" role="search" action="/listings/search" method="get">
        <div class="input-group">
          <input class="form-control search-input" type="search" placeholder="Search Destinations" name="q">
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>
    </div>
     <% } %>

    <!-- Collapsible menu -->
  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
  <div class="navbar-nav ms-auto">
    <div class="navbar-nav">
        <a class="nav-link" href="/listings">Home</a>
      </div>

    <% if (!(req.originalUrl === "/login" || req.originalUrl === "/signup")) { %>
      <a class="nav-link" href="/listings/new">Add new Listing</a>
      <!-- Optional: add search bar here -->
    <% } %>

    <% if(!currUser){ %>
      <a class="nav-link active" href="/signup"><b>Sign up</b></a>
      <a class="nav-link" href="/login"><b>Login</b></a>
    <% } else { %>
      <a class="nav-link" href="/logout"><b>Log out</b></a>
    <% } %>
  </div>
</div>

  </div>
</nav>
